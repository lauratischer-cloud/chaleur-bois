  <span class=\"product-header__label\">Marque<\/span>\n        <span class=\"product-header__value\">{{ product.vendor }}<\/span>\n      <\/div>\n    {%- endif -%}\n\n    {%- if product.selected_or_first_available_variant.sku != blank -%}\n      <div class=\"product-header__item\">\n        <span class=\"product-header__label\">Référence<\/span>\n        <span class=\"product-header__value\">{{ product.selected_or_first_available_variant.sku }}<\/span>\n      <\/div>\n    {%- endif -%}\n\n    <div class=\"product-header__item\">\n      <span class=\"product-header__label\">En stock<\/span>\n      {%- if product.available -%}\n        {%- assign total_stock = 0 -%}\n        {%- for variant in product.variants -%}\n          {%- if variant.inventory_management == 'shopify' -%}\n            {%- assign total_stock = total_stock | plus: variant.inventory_quantity -%}\n          {%- endif -%}\n        {%- endfor -%}\n        {%- if total_stock > 0 -%}\n          <span class=\"product-header__value product-header__value--instock\">Oui ✓<\/span>\n        {%- else -%}\n          <span class=\"product-header__value product-header__value--instock\">Oui ✓<\/span>\n        {%- endif -%}\n      {%- else -%}\n        <span class=\"product-header__value product-header__value--outstock\">Non<\/span>\n      {%- endif -%}\n    <\/div>\n\n  <\/div>\n\n  {%- comment -%} ── Fiche technique ── {%- endcomment -%}\n\n  {%- liquid\n    assign has_tech = false\n    if product.metafields.custom.poids_total != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.dimensions_de_l_ensemble != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.dimensions_foyer != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.diametre_sortie_de_fumee != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.type != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.puissance_thermique != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.pression_pompe != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.force_de_fendage != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.vitesse != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.entrainement != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.surface_chauffee != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.rendement != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.longueur_buche_maxi != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.combustible != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.puissance_chaudiere != blank\n      assign has_tech = true\n    endif\n    if product.metafields.custom.puissance_bouilleur != blank\n      assign has_tech = true\n    endif\n  -%}\n\n  {%- if has_tech -%}\n  <div class=\"product-tech\">\n    <h3 class=\"product-tech__title\">Fiche technique<\/h3>\n    <table class=\"product-tech__table\">\n      <tbody>\n\n        {%- if product.metafields.custom.poids_total != blank -%}\n          <tr><th scope=\"row\">Poids total<\/th><td>{{ product.metafields.custom.poids_total }}<\/td><\/tr>\n        {%- endif -%}\n\n        {%- if product.metafields.custom.dimensions_de_l_ensemble != blank -%}\n          <tr><th scope=\"row\">Dimensions de l'ensemble<\/th><td>{{ product.metafields.custom.dimensions_de_l_ensemble }}<\/td><\/tr>\n        {%- endif -%}\n\n        {%- if product.metafields.custom.dimensions_foyer != blank -%}\n          <tr><th scope=\"row\">Dimensions four \/ foyer<\/th><td>{{ product.metafields.custom.dimensions_foyer }}<\/td><\/tr>\n        {%- endif -%}\n\n        {%- if product.metafields.custom.diametre_sortie_de_fumee != blank -%}\n       